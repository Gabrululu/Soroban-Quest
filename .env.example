# --- Build time (public, embedded in the client bundle) ---
# Public origin of the deployed site, used for absolute social-card URLs.
VITE_SITE_URL=https://example.com
# Sentry DSN for browser errors (DSNs are public by design). Leave empty to disable.
VITE_SENTRY_DSN=
# Environment tag for server events (default: production).
SENTRY_ENVIRONMENT=

# --- Server (local dev only; in production use `wrangler secret put`) ---
# HMAC key for wallet challenges and session tokens. Required in production.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SOROBAN_QUEST_SECRET=
# Sentry DSN for server errors. Leave empty to disable.
SENTRY_DSN=
